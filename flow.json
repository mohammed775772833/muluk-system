                "label": "مراجعة الطلب",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "REVIEW"
                  },
                  "payload": {
                    "car": "${screen.CAR.form.car}",
                    "model_year": "${screen.CAR.form.model_year}",
                    "services": "${data.services}",
                    "customer_name": "${form.customer_name}",
                    "governorate": "${form.governorate}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "مراجعة الطلب",
      "data": {
        "car": {
          "type": "string",
          "__example__": "camry"
        },
        "model_year": {
          "type": "string",
          "__example__": "2020"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": [
            "seats",
            "floor"
          ]
        },
        "customer_name": {
          "type": "string",
          "__example__": "محمد"
        },
        "governorate": {
          "type": "string",
          "__example__": "taiz"
        }
      },
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "✅ مراجعة الطلب"
          },
          {
            "type": "TextBody",
            "text": "سيتم إرسال طلبك إلى ملوك التنجيد للمراجعة وتحديد الموعد لاحقًا."
          },
          {
            "type": "TextBody",
            "text": "👤 الاسم:"
          },
          {
            "type": "TextBody",
            "text": "${data.customer_name}"
          },
          {
            "type": "TextBody",
            "text": "🚗 السيارة:"
          },
          {
            "type": "TextBody",
            "text": "${data.car}"
          },
          {
            "type": "TextBody",
            "text": "📅 سنة الموديل:"
          },
          {
            "type": "TextBody",
            "text": "${data.model_year}"
          },
          {
            "type": "TextBody",
            "text": "📍 المحافظة:"
          },
          {
            "type": "TextBody",
            "text": "${data.governorate}"
          },
          {
            "type": "TextBody",
            "text": "💰 الأسعار: المقاعد ‎̶6̶0̶,̶0̶0̶0̶‎ → 40,000 — الأرضية رقم واحد ‎̶2̶5̶,̶0̶0̶0̶‎ → 18,999 — الطبلون الملكي ‎̶6̶,̶0̶0̶0̶‎ → 3,999 — الطبلون العادي ‎̶4̶,̶0̶0̶0̶‎ → 2,999 ريال"
          },
          {
            "type": "Footer",
            "label": "إرسال الطلب",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "car": "${screen.CAR.form.car}",
                "model_year": "${screen.CAR.form.model_year}",
                "services": "${data.services}",
                "customer_name": "${screen.CUSTOMER.form.customer_name}",
                "governorate": "${screen.CUSTOMER.form.governorate}"
              }
            }
          }
        ]
      }
    }
  ]
}
                  {
                    "id": "shabwah",
                    "title": "شبوة"
                  },
                  {
                    "id": "saada",
                    "title": "صعدة"
                  },
                  {
                    "id": "hajjah",
                    "title": "حجة"
                  },
                  {
                    "id": "amran",
                    "title": "عمران"
                  },
                  {
                    "id": "al_mahwit",
                    "title": "المحويت"
                  },
                  {
                    "id": "raymah",
                    "title": "ريمة"
                  },
                  {
                    "id": "al_jawf",

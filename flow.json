{
  "version": "7.2",
  "screens": [
    {
      "id": "CAR",
      "title": "اختيار السيارة",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "car_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "🚗 اختر سيارتك"
              },
              {
                "type": "Dropdown",
                "name": "car",
                "label": "نوع السيارة",
                "required": true,
                "data-source": [
                  {
                    "id": "camry",
                    "title": "كامري"
                  },
                  {
                    "id": "corolla",
                    "title": "كورولا"
                  },
                  {
                    "id": "elantra",
                    "title": "إلنترا"
                  },
                  {
                    "id": "accent",
                    "title": "أكسنت"
                  },
                  {
                    "id": "yaris",
                    "title": "يارس"
                  },
                  {
                    "id": "rav4",
                    "title": "راف فور — 2018 أو أقدم"
                  },
                  {
                    "id": "hilux",
                    "title": "هيلوكس"
                  },
                  {
                    "id": "sonata",
                    "title": "سوناتا"
                  },
                  {
                    "id": "tucson",
                    "title": "توسان"
                  },
                  {
                    "id": "santafe",
                    "title": "سنتافي — مرحلتان فقط"
                  },
                  {
                    "id": "sportage",
                    "title": "سبورتاج"
                  },
                  {
                    "id": "pride",
                    "title": "برايد"
                  },
                  {
                    "id": "kia_lucca",
                    "title": "كيا لوتشي"
                  },
                  {
                    "id": "legend",
                    "title": "الأسطورة"
                  },
                  {
                    "id": "grand_vitara",
                    "title": "فيتارا جراند"
                  },
                  {
                    "id": "matiz",
                    "title": "ماتيز"
                  },
                  {
                    "id": "other",
                    "title": "أخرى..."
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "model_year",
                "label": "سنة الموديل",
                "input-type": "text",
                "required": true
              },
              {
                "type": "Footer",
                "label": "التالي",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "SERVICES"
                  },
                  "payload": {
                    "car": "${form.car}",
                    "model_year": "${form.model_year}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SERVICES",
      "title": "اختيار الخدمات",
      "data": {
        "car": {
          "type": "string",
          "__example__": "camry"
        },
        "model_year": {
          "type": "string",
          "__example__": "2020"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "service_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "🧰 اختر الخدمات"
              },
              {
                "type": "TextBody",
                "text": "الأسعار ثابتة لجميع السيارات المشمولة بالعرض."
              },
              {
                "type": "CheckboxGroup",
                "name": "services",
                "label": "الخدمات المطلوبة",
                "required": true,
                "min-selected-items": 1,
                "max-selected-items": 4,
                "data-source": [
                  {
                    "id": "seats",
                    "title": "تنجيد المقاعد — ‎̶6̶0̶,̶0̶0̶0̶‎ ريال 40,000 ريال"
                  },
                  {
                    "id": "floor",
                    "title": "فرشة الأرضية رقم واحد — ‎̶2̶5̶,̶0̶0̶0̶‎ ريال 18,999 ريال"
                  },
                  {
                    "id": "royal_dashboard",
                    "title": "فرشة الطبلون الملكي — ‎̶6̶,̶0̶0̶0̶‎ ريال 3,999 ريال"
                  },
                  {
                    "id": "normal_dashboard",
                    "title": "فرشة الطبلون العادي — ‎̶4̶,̶0̶0̶0̶‎ ريال 2,999 ريال"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "التالي",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "CUSTOMER"
                  },
                  "payload": {
                    "car": "${screen.CAR.form.car}",
                    "model_year": "${screen.CAR.form.model_year}",
                    "services": "${form.services}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CUSTOMER",
      "title": "بيانات العميل",
      "data": {
        "car": {
          "type": "string",
          "__example__": "camry"
        },
        "model_year": {
          "type": "string",
          "__example__": "2020"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": [
            "seats",
            "floor"
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
